# Supabase configuration for blog data (backend)
# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Instructions:
# 1. Create free project at https://supabase.com
# 2. Create table "blogs" (see SQL in src/lib/supabase.ts or docs)
# 3. Copy URL and anon key here
# 4. BlogList will fetch live data. Falls back to static if not set.